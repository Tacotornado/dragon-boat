# Stroke Analysis Dashboard Configuration

# Neon / Postgres connection string
DATABASE_URL=

# Set to "true" to run the compiled C++ stroke_analysis binary on upload.
# Requires engine/utilities/ and engine/vendor/matplotlibcpp.h to be present at
# image build time.
USE_CPP_ENGINE=true

# Path to the compiled C++ binary inside the container
CPP_ENGINE_PATH=/app/engine/stroke_analysis

# Kill the engine if a single run takes longer than this (ms)
CPP_ENGINE_TIMEOUT_MS=120000

# Where per-run plots and workbooks are stored
ARTIFACT_DIR=/app/data/runs

# IMU sample rate used for duration math (the C++ filter also assumes 120 Hz)
SAMPLE_RATE_HZ=120

# Headless matplotlib backend (required for matplotlib-cpp in Docker)
MPLBACKEND=Agg

# Server port (default: 3000)
PORT=3000
